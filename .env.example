# ==============================================================================
# Cognexa AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=cognexa
POSTGRES_PASSWORD=cognexa123
POSTGRES_DB=cognexa_db
DATABASE_URL=postgresql+asyncpg://cognexa:cognexa123@localhost:5432/cognexa_db

# Ollama Local LLM Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embeddings Model (HuggingFace Sentence Transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Authentication & Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Docker Sandbox & Execution Safety
DOCKER_SANDBOX_IMAGE=cognexa-backend:local
DOCKER_GID=999
MAX_RETRIES=3
SANDBOX_TIMEOUT=30
SANDBOX_TEST_TIMEOUT=180

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
